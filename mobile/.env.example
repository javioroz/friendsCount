# ==================================================================
# FriendsCount - Mobile (Expo)
# ==================================================================
# Este archivo va en mobile/.env, NO en la raiz del monorepo.
# Expo lee el .env de la raiz del proyecto Expo, que aqui es mobile/.
# Copialo: cp .env.example .env
#
# IMPORTANTE
# Solo las variables con prefijo EXPO_PUBLIC_ se sustituyen al compilar
# (node_modules/babel-preset-expo/build/inline-env-vars.js). Si le
# quitas el prefijo, llegara como undefined y la app caera a
# localhost, que en un telefono es el propio telefono.
# ==================================================================

# ------------------------------------------------------------------
# Relay de GunDB
# ------------------------------------------------------------------
# Desarrollo: el manifest de debug permite trafico cleartext (ws://).
EXPO_PUBLIC_GUN_RELAY=ws://localhost:3001/gun

# Produccion: DEBE ser wss://. El manifest de release no declara
# usesCleartextTraffic, asi que Android 9+ bloquea ws:// y el peer
# no conectaria nunca. Pon aqui el dominio publico de tu servicio
# en Railway, terminado en /gun. Ejemplo (sustituir por el real):
#   EXPO_PUBLIC_GUN_RELAY=wss://tu-servicio.up.railway.app/gun
#
# La app muestra el error en la pantalla /debug si esto falta o si
# el esquema no es wss:// en un build de release.
