# FriendsCount - Environment Variables - Variables de entorno
# ==================================================================
# Copy this file and rename as .env configuring your env variable
# Copia este archivo como .env y configura tus variables de entorno

# ==================================================================
# Mobile (Development)
# ==================================================================
EXPO_ROUTER_APP_ROOT=mobile/app
EXPO_ROUTER_IMPORT_MODE=sync

# ==================================================================
# Server
# ==================================================================
PORT=3001
GUN_RELAY_HOST=192.168.0.42
NODE_ENV=development
# Absolute path for the GunDB data directory. Defaults to server/radata.
# On Railway set it to your volume mount path, e.g. /app/server/radata
# GUN_DATA_PATH=/app/server/radata